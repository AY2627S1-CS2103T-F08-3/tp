@startuml
!include style.puml
skinparam ArrowFontStyle plain

Actor User as user USER_COLOR
Participant ":UI" as ui UI_COLOR
Participant ":Logic" as logic LOGIC_COLOR
Participant ":Model" as model MODEL_COLOR
Participant ":Storage" as storage STORAGE_COLOR

user -[USER_COLOR]> ui : "delete 1"
activate ui UI_COLOR

ui -[UI_COLOR]> logic : execute("delete 1")
activate logic LOGIC_COLOR

logic -[LOGIC_COLOR]> model : copyForCommand()
activate model MODEL_COLOR
model -[MODEL_COLOR]-> logic : proposed
deactivate model

logic -[LOGIC_COLOR]> logic : command.execute(proposed)
note right of logic: deletes the student\nfrom the staged copy only

logic -[LOGIC_COLOR]> storage : saveStudentDirectory(proposed data)
activate storage STORAGE_COLOR

storage -[STORAGE_COLOR]> storage : write temp file,\natomic replace
activate storage STORAGE_COLOR_T1
storage --[STORAGE_COLOR]> storage
deactivate storage

storage --[STORAGE_COLOR]> logic
deactivate storage

logic -[LOGIC_COLOR]> model : publish(proposed)
activate model MODEL_COLOR
model -[MODEL_COLOR]-> logic
deactivate model

logic --[LOGIC_COLOR]> ui : CommandResult
deactivate logic

ui--[UI_COLOR]> user
deactivate ui
@enduml
