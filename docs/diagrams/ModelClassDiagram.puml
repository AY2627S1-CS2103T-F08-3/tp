@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyStudentDirectory" as ReadOnlyStudentDirectory
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class StudentDirectory
Class ModelManager {
  selectedStudentId: UUID
  studentPredicate
}
Class UserPrefs
Class UniqueStudentList
Class WeeklySchedule
Class Student {
  id: UUID
}
Class Name
Class Phone
Class Address
Class StudentFields
Class "<<interface>>\nStudentField<T>" as StudentField
Class "Optional field types" as OptionalTypes
note bottom of OptionalTypes
  GuardianPhone, EducationLevel, Subject,
  HourlyRate, WeeklySlot, AcademicNote,
  AssessmentHistory, PaymentHistory
end note
Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

StudentDirectory .up.|> ReadOnlyStudentDirectory

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyStudentDirectory
ModelManager -left-> "1" StudentDirectory
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

StudentDirectory *--> "1" UniqueStudentList
UniqueStudentList --> "~* all" Student
ModelManager --> "~* filtered" Student
WeeklySchedule ..> "~* scheduled" Student : sorts all students\nby day, time, order

Student *--> Name
Student *--> Phone
Student *--> Address
Student *--> "1" StudentFields
StudentFields ..> StudentField : get / with / without
StudentField ..> OptionalTypes : decodes and encodes

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
@enduml
