@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":TutorConnectParser" as TutorConnectParser LOGIC_COLOR
participant "u:UndoCommand" as UndoCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
end box
[-> LogicManager : execute(undo)
activate LogicManager

LogicManager -> TutorConnectParser : parseCommand(undo)
activate TutorConnectParser

create UndoCommand
TutorConnectParser -> UndoCommand
activate UndoCommand

UndoCommand --> TutorConnectParser
deactivate UndoCommand

TutorConnectParser --> LogicManager : u
deactivate TutorConnectParser

LogicManager -> UndoCommand : execute()
activate UndoCommand

UndoCommand -> Model : undoStudentDirectory()
activate Model

Model --> UndoCommand
deactivate Model

UndoCommand --> LogicManager : result
deactivate UndoCommand
UndoCommand -[hidden]-> LogicManager : result
destroy UndoCommand

[<--LogicManager
deactivate LogicManager
@enduml
