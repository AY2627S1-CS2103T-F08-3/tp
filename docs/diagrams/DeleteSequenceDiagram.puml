@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":TutorConnectParser" as TutorConnectParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "p:Model" as Proposed MODEL_COLOR
end box

[-> LogicManager : execute("delete 1")
activate LogicManager

LogicManager -> TutorConnectParser : parseCommand("delete 1")
activate TutorConnectParser

create DeleteCommandParser
TutorConnectParser -> DeleteCommandParser
activate DeleteCommandParser

DeleteCommandParser --> TutorConnectParser
deactivate DeleteCommandParser

TutorConnectParser -> DeleteCommandParser : parse("1")
activate DeleteCommandParser

create DeleteCommand
DeleteCommandParser -> DeleteCommand
activate DeleteCommand

DeleteCommand --> DeleteCommandParser :
deactivate DeleteCommand

DeleteCommandParser --> TutorConnectParser : d
deactivate DeleteCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteCommandParser -[hidden]-> TutorConnectParser
destroy DeleteCommandParser

TutorConnectParser --> LogicManager : d
deactivate TutorConnectParser

LogicManager -> Model : copyForCommand()
activate Model
create Proposed
Model -> Proposed
Model --> LogicManager : p
deactivate Model

LogicManager -> DeleteCommand : execute(p)
activate DeleteCommand

DeleteCommand -> Proposed : getFilteredStudentList()
activate Proposed
Proposed --> DeleteCommand : displayed list
deactivate Proposed

DeleteCommand -> Proposed : deleteStudent(target)
activate Proposed
Proposed --> DeleteCommand
deactivate Proposed

create CommandResult
DeleteCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteCommand
deactivate CommandResult

DeleteCommand --> LogicManager : r
deactivate DeleteCommand

LogicManager -> LogicManager : save p's data to Storage

LogicManager -> Model : publish(p)
activate Model
Model --> LogicManager
deactivate Model

[<--LogicManager
deactivate LogicManager
@enduml
